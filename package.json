{
  "name": "ghostcoach",
  "version": "2.9.8",
  "description": "Real-time Valorant AI coaching overlay",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "generate-icon": "node scripts/generate-icon.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist": "electron-builder --win --mac",
    "release": "electron-builder --win --publish always && node scripts/publish-download.js",
    "sync:valorant": "node scripts/sync-valorant-data.js",
    "sync:patch": "node scripts/sync-patch-notes.js",
    "publish:download": "node scripts/publish-download.js",
    "check:playbook": "node scripts/check-playbook.js",
    "test:deathspot": "node scripts/test-death-spot.js",
    "test:habits": "node scripts/test-habits.js",
    "test:maps": "node scripts/test-map-labels.js",
    "check:server": "node scripts/check-server-boot.js",
    "bench:models": "node scripts/bench-models.js",
    "test:alive": "node scripts/test-alive-claims.js",
    "test:matchlink": "node scripts/test-match-link.js",
    "test:variety": "node scripts/test-variety.js",
    "test:scoreboard": "node scripts/test-scoreboard.js",
    "test:agentkit": "node scripts/test-agent-kit.js",
    "test:rejects": "node scripts/test-reject-reasons.js"
  },
  "build": {
    "appId": "com.ghostcoach.app2",
    "productName": "GhostCoach 2.0",
    "artifactName": "GhostCoach 2.0 Setup.${ext}",
    "copyright": "Copyright © 2025 GhostCoach",
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/GhostCoachCapture.exe",
        "to": "GhostCoachCapture.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.games"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GhostCoach 2.0",
      "uninstallDisplayName": "GhostCoach 2.0",
      "include": "build/uninstaller.nsh"
    },
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "lowful",
      "repo": "GhostCoach-releases",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  },
  "keywords": [
    "electron",
    "gaming",
    "ai",
    "overlay",
    "coach"
  ],
  "author": "GhostCoach",
  "license": "MIT"
}
